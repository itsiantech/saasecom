# ==========================================================================
# SaaS billing email + reminder system
# --------------------------------------------------------------------------
# REDIS_URL khali thakle web app queue chara inline mail pathabe (dev/test).
# Production e Redis set kore "npm run worker" alada process hisebe chalate hobe.
REDIS_URL=redis://127.0.0.1:6379

# Brevo transactional SMTP (platform billing mail — tenant order mail na)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="LUXE Billing" <no-reply@your-domain.com>

# Daily send cap — Brevo free tier 300/day; 280 rakhle headroom thake
SAAS_EMAIL_DAILY_CAP=280

# Daily reminder pass (Asia/Dhaka). "off" dile cron bondho.
BILLING_CRON=0 9 * * *
BILLING_TZ=Asia/Dhaka
BILLING_HOUR=9

# Due date +3 din: past_due email | +7 din: suspend notice
BILLING_SUSPEND_AFTER_DAYS=7
# true hole suspend howar somoy storefront-o bondho hoy (default: shudhu status)
BILLING_AUTO_SUSPEND=false

# Payment link + store link banate lagbe
APP_URL=https://your-domain.com
